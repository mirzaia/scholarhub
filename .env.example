# Inject DATABASE_URL through your shell or deployment secret manager.
# Prisma and Next.js read it from the environment. Never commit credentials.
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Docker Compose database settings. Inject POSTGRES_PASSWORD separately.
# DATABASE_URL must use the same user, password, and database, with host db:5432.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=scholarhub
